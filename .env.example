# Optional. Leave empty to use on-disk PGlite under .data/pglite.
DATABASE_URL=
# Optional. Used by npm run db:migrate when DATABASE_URL goes through a pooler.
DATABASE_URL_UNPOOLED=

# Resend Inbound webhook signing secret (Svix). Required for POST /api/inbound/email.
RESEND_WEBHOOK_SECRET=

# Resend API key. Required to fetch the email body after email.received webhooks
# (Resend webhooks carry metadata only).
RESEND_API_KEY=

# Optional. If set to a task_groups.id, that group is applied when an inquiry
# event is created from inbound email. Leave unset for no auto-apply.
INBOUND_DEFAULT_TASK_GROUP_ID=

# Verified Resend sender for outbound assignment / change / due-task emails.
# Required together with RESEND_API_KEY for notifications (local skip if unset).
RESEND_FROM_EMAIL=

# Public base URL used in notification email links.
APP_BASE_URL=http://localhost:3000

# Text-message notifications (Twilio). Leave empty to skip SMS.
# TWILIO_FROM_NUMBER is a Twilio number in +1... form, or a Messaging Service SID (MG...).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Telegram notifications. Bot token from @BotFather. Leave empty to skip Telegram.
TELEGRAM_BOT_TOKEN=
# Only needed when the bot uses a webhook (POST /api/telegram/webhook).
TELEGRAM_WEBHOOK_SECRET=

# Shared secret for POST/GET /api/cron/due-tasks (Authorization: Bearer only).
CRON_SECRET=
