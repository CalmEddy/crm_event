# Optional. Leave empty to use on-disk PGlite under .data/pglite.
DATABASE_URL=
# Optional. Used by npm run db:migrate when DATABASE_URL goes through a pooler.
DATABASE_URL_UNPOOLED=

# Resend Inbound webhook signing secret (Svix). Required for POST /api/inbound/email.
RESEND_WEBHOOK_SECRET=

# Resend API key. Required to fetch the email body after email.received webhooks
# (Resend webhooks carry metadata only).
RESEND_API_KEY=

# Optional. If set to a task_groups.id, that group is applied when an inquiry
# event is created from inbound email. Leave unset for no auto-apply.
INBOUND_DEFAULT_TASK_GROUP_ID=
